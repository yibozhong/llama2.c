# Submit from the repository root: condor_submit -i gradformer/chtc/build.sub
universe = vanilla
executable = /usr/bin/hostname
transfer_input_files = gradformer/chtc/uv.def,pyproject.toml,uv.lock
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = build-manifest.txt
+IsBuildJob = true
requirements = (HasCHTCStaging == true)
request_cpus = 8
request_memory = 16GB
request_disk = 30GB
log = build.$(Cluster).log
output = build.$(Cluster).out
error = build.$(Cluster).err
queue 1
