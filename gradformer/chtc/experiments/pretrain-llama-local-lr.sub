universe = vanilla
container_image = file:///staging/y/yzhong239/gradformer/llama2-uv-v4.sif
executable = pretrain-llama-local-lr.sh
arguments = $(eta) $(lr) $(label) $(objective) $(checks)
transfer_input_files = ../bundles/llama2-local-lr-v1.tar.gz,../bundles/cce-3de376c.tar.gz,../bundles/dataset-v1.tar,/home/yzhong239/.netrc
