universe = vanilla
container_image = file:///staging/y/yzhong239/gradformer/llama2-uv-v4.sif
executable = pretrain-llama-cosine-head.sh
arguments = $(eta) $(lr) $(label) $(mode) $(last_eta) $(checks)
transfer_input_files = ../bundles/llama2-cosine-head-v1.tar.gz,../bundles/dataset-v1.tar,/home/yzhong239/.netrc
